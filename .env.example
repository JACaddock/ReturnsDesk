# A list of the settings the code reads. Set these in your shell, or copy this file to .env (git ignores .env):
# Docker Compose reads .env, the Python code on its own doesn't.
# Never put a real key in this file; it is committed.

# Claude API (paid). Leave the base URL unset.
ANTHROPIC_API_KEY=

# Free local alternative: Ollama (see README).
# ANTHROPIC_BASE_URL=http://localhost:11434
# (In Docker, use http://host.docker.internal:11434 to reach Ollama on your machine.)
# ANTHROPIC_API_KEY=ollama
# RETURNS_DESK_AGENT_MODEL=qwen3:4b
# RETURNS_DESK_CUSTOMER_MODEL=qwen3:4b
# RETURNS_DESK_JUDGE_MODEL=qwen3:4b

# Optional overrides
# RETURNS_DESK_AGENT_MODEL=claude-opus-5-5
# RETURNS_DESK_AGENT_EFFORT=medium
# RETURNS_DESK_CUSTOMER_MODEL=claude-haiku-5-5
# RETURNS_DESK_JUDGE_MODEL=claude-sonnet-5-5
# RETURNS_DESK_DB=data/returns_desk.db

# Policy search embeddings (always local Ollama)
# RETURNS_DESK_EMBED_URL=http://localhost:11434
# RETURNS_DESK_EMBED_MODEL=nomic-embed-text
